# Bu dosyayı kopyalamayın; değerleri Vercel > Project > Settings > Environment Variables'a girin.

# Sitenin tam adresi (sonunda / olmadan)
NEXT_PUBLIC_SITE_URL=https://armahane.vercel.app

# Neon Postgres (Vercel Marketplace'ten Neon eklenince otomatik gelir)
DATABASE_URL=

# Yönetim paneli (/yonetim) şifresi ve oturum imzalama anahtarı (uzun rastgele metin)
ADMIN_PASSWORD=
ADMIN_SECRET=

# PayTR (Mağaza Paneli > Bilgi). Boş bırakılırsa kartla ödeme seçeneği gizlenir.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 = test modu, 0 = canlı
PAYTR_TEST_MODE=1

# Havale bilgileri (ödeme sayfasında gösterilir)
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_IBAN=

# Vercel Blob (logo yükleme). Vercel > Storage > Blob eklenince otomatik gelir.
BLOB_READ_WRITE_TOKEN=

# Resend (sipariş e-postaları). Boşsa e-posta gönderilmez.
RESEND_API_KEY=
MAIL_FROM=Armahane <siparis@armahane.com>
SHOP_NOTIFY_EMAIL=
